rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // จุกจิกการค้า: ใช้ได้เฉพาะบัญชีเจ้าของร้าน ทุกเครื่องที่ล็อกอินบัญชีนี้
    function isOwner() {
      return request.auth != null && request.auth.uid == '6aNH4DgIqSfQA9KbOWVcwLc3Jzn1';
    }
    match /users/{uid} {
      allow read, write: if isOwner() && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if isOwner() && request.auth.uid == uid;
      }
    }
  }
}
